# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않습니다. 토큰은 절대 커밋하지 마세요.
# 비워 둔 소스는 "설정 안 됨"으로 보고되고, 나머지 소스는 정상적으로 동작합니다.

# ── Claude ─────────────────────────────────────────────
# Claude 인증은 아래 두 방법 중 하나입니다. 자세한 내용은 README의 "Claude 인증"을 보세요.
#
# 방법 1: Anthropic API 키 (platform.claude.com의 API Keys에서 발급, sk-ant-로 시작).
# 게이트웨이(방법 2)를 쓸 때는 반드시 비워 두세요. 값이 있으면 게이트웨이 인증이 실패합니다.
ANTHROPIC_API_KEY=
#
# 방법 2: Anthropic 호환 LLM 게이트웨이 (예: 대학에서 제공하는 Chat KHU). 쓰려면 아래 줄들의 맨 앞 #을 지우고 채우세요.
# 게이트웨이가 Anthropic Messages 형식(/v1/messages)을 지원해야 합니다. OpenAI 호환 형식만 되는 곳은 쓸 수 없습니다.
# 게이트웨이 주소. Chat KHU는 화면에 보이는 .../v1/gateway 끝에 /claude를 붙인 주소입니다.
# ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
# 게이트웨이에서 발급한 키.
# ANTHROPIC_AUTH_TOKEN=
# (선택) 게이트웨이의 Haiku 모델 ID. Claude Code가 가벼운 보조 작업에 씁니다.
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
#
# 고뭉치가 쓸 모델 (업뎃·일정은 같은 모델을 그대로 이어받습니다). 비워 두면 기본 모델(아래 값)을 씁니다.
# 게이트웨이는 모델 ID가 다를 수 있습니다. python -m mungchi --list-models 로 쓸 수 있는 ID를 확인하세요.
MUNGCHI_MODEL=claude-opus-5-5

# ── Chat KHU 크레딧 (게이트웨이가 Chat KHU일 때만) ──────────
# python -m mungchi --credits 나 Slack에서 "크레딧"이라고 보내면 남은 크레딧을 바로 보여 줍니다(LLM 호출 없음).
# Slack 봇이 켜져 있는 동안 1시간마다 크레딧을 확인해, 남은 크레딧이 이 비율(%) 아래로 내려가면
# SLACK_ALLOWED_USER_IDS의 사람에게 DM을 보냅니다(갱신 주기마다 한 번만). 기본 10. 0이나 빈 값이면 알림을 끕니다.
CREDIT_ALERT_PERCENT=10
# (선택) 크레딧 API 주소. 비우면 ANTHROPIC_BASE_URL에서 끝의 /claude를 뺀 주소를 씁니다
# (Chat KHU: https://factchat-cloud.mindlogic.ai/v1/gateway). 보통은 비워 두세요.
CREDITS_API_BASE=

# ── 공통 ──────────────────────────────────────────────
# 일정·시각 표시에 쓸 시간대 (IANA 이름). 기본 Asia/Seoul.
TIMEZONE=Asia/Seoul
# 브리핑 기록이 없을 때(첫 브리핑) Dropbox를 며칠 전부터 볼지. 기본 1(최근 24시간).
# 그다음 브리핑부터는 지난 브리핑 이후의 변경을 봅니다.
LOOKBACK_DAYS=1
# 브리핑 기준 시각·아침 브리핑 날짜 등을 저장할 파일 경로. 비우면 현재 폴더의 .mungchi_state.json.
MUNGCHI_STATE_FILE=

# ── 아침 브리핑 (Slack 봇이 매일 자동으로 보냄) ─────────────
# 고뭉치 봇이 날씨, 오늘의 일정, Dropbox 업데이트, Chat KHU 남은 크레딧을 보낼 시각(24시간제 HH:MM, TIMEZONE 기준).
# 예: 07:00. 비워 두면 아침 브리핑을 보내지 않습니다. 잘못 적으면(예: 7시) 봇은 그대로 돌고 아침 브리핑만 꺼집니다.
# 고친 뒤에는 python -m mungchi service restart. 지금 바로 시험하려면 python -m mungchi --brief --slack.
BRIEF_TIME=
# 보낼 요일: daily(매일, 기본) 또는 weekdays(평일 월–금).
BRIEF_DAYS=daily
# 그 시각에 Mac이 잠자고 있었거나 봇이 늦게 켜졌으면, 깨어난 뒤 이 시각 전까지는 그날 브리핑을 보냅니다.
# 이 시각이 지나면 그날은 건너뜁니다. 기본 12:00. BRIEF_TIME이 이보다 늦으면 그날 자정까지 보냅니다.
BRIEF_CATCHUP_UNTIL=12:00

# ── 날씨 (Open-Meteo, 무료·키 필요 없음, LLM 호출 없음) ─────────
# 브리핑(--brief, --brief --slack, 아침 브리핑) 제목 바로 아래에 그날 날씨 한 줄을 붙입니다.
# 예: 🌤️ 서울 날씨: 대체로 맑음 · 최저 12° / 최고 23° · 강수확률 10% · 미세먼지 보통
# 기본은 켜짐. off(또는 0, false)면 브리핑에서 뺍니다(python -m mungchi --weather와 Slack의 "날씨" 답은 그대로 됩니다).
BRIEF_WEATHER=on
# 날씨 줄에 보여 줄 지역 이름. 기본 서울.
WEATHER_LABEL=서울
# 날씨를 볼 곳의 위도·경도(숫자). 기본은 서울시청(37.5665, 126.9780). 둘 다 적어야 하고,
# 잘못 적거나 하나만 적으면 로그에 경고를 남기고 서울 날씨를 보여 줍니다.
WEATHER_LAT=37.5665
WEATHER_LON=126.9780

# ── Dropbox (업뎃) ────────────────────────────────────
# 방법 1: 액세스 토큰 하나 (앱 콘솔에서 생성. 몇 시간 뒤 만료되므로 테스트용).
DROPBOX_ACCESS_TOKEN=
# 방법 2 (권장): 만료되지 않는 리프레시 토큰 + 앱 키 + 앱 시크릿. README의 발급 방법 참고.
DROPBOX_REFRESH_TOKEN=
# Dropbox 앱 콘솔 Settings 탭의 App key.
DROPBOX_APP_KEY=
# Dropbox 앱 콘솔 Settings 탭의 App secret.
DROPBOX_APP_SECRET=
# 확인할 폴더. 기본값은 /20_연구-진행 (Dropbox 맨 위의 20_연구-진행 폴더)이라 비워 둬도 됩니다.
# 이 폴더가 다른 폴더 안에 있으면 전체 경로를 적으세요. 예: /Research/20_연구-진행
# 하위 폴더별로 공저자가 바꾼 파일 목록만 보고합니다(토큰 절약을 위해 파일 내용은 읽지 않음).
DROPBOX_ROOT_FOLDER=/20_연구-진행

# ── 캘린더 ('일정' 에이전트) ─────────────────────────────────────
# 일정을 어디서 읽을지: auto(기본) | macos | ics. 설정 방법은 README의 "캘린더" 참고.
# - auto: CALENDAR_ICS_URLS가 있으면 그 주소를, 비어 있으면 Mac에서는 캘린더 앱을 바로 읽습니다.
# - macos: Mac 캘린더 앱을 바로 읽습니다(공개 링크 필요 없음). 처음 한 번 터미널에서
#   python -m mungchi --calendar-setup 을 실행해 캘린더 접근을 허용하세요.
# - ics: CALENDAR_ICS_URLS의 주소만 읽습니다.
CALENDAR_SOURCE=auto
# (macos) 읽을 캘린더 이름 (쉼표로 구분, 대소문자 무시). 비우면 캘린더 앱의 모든 캘린더를 읽습니다.
# 이름은 캘린더 앱 사이드바에 보이는 그대로 적으세요. 예: 연구,수업,Work
MACOS_CALENDARS=
# (ics) ICS 주소들 (쉼표로 구분). 캘린더가 여러 개면 모두 넣으세요. Mac 캘린더 앱을 바로 읽을 거면 비워 두세요.
# - macOS 캘린더 앱의 iCloud 캘린더: 캘린더를 Control-클릭 > 캘린더 공유… > 공개 캘린더의 webcal:// 주소를 그대로 붙여 넣기
#   (webcal://, webcals://는 자동으로 https://로 바꿔 읽습니다)
# - Google 캘린더의 "iCal 형식의 비공개 주소", Outlook "캘린더 게시"의 ICS 주소
# - "나의 Mac에" 로컬 캘린더는 주소가 없어 ICS로는 읽을 수 없습니다(macos 방식으로는 읽힙니다).
# 이 주소는 비밀번호와 같습니다(공개 캘린더는 주소를 아는 누구나 볼 수 있음). 유출되면 재설정하거나 공개를 끄세요.
CALENDAR_ICS_URLS=

# ── 메모로 일정 추가 (Mac 캘린더 모드에서만) ─────────────────────
# @업뎃·@일정(또는 고뭉치)에게 날짜·시간이 든 메모를 붙여 넣으면 미리보기를 보여 주고, 카테고리를 골라야(번호·이름·버튼,
# 추천대로면 "네") 캘린더에 추가합니다. README의 "메모로 일정 추가하기" 참고. ICS 주소(CALENDAR_ICS_URLS)로 읽을 때는 추가할 수 없습니다.
# 카테고리 = Mac 캘린더 앱의 캘린더 이름 (쉼표로 구분, 적은 순서가 번호 1, 2, 3…). 캘린더 앱에 같은 이름의 캘린더가 있어야 합니다.
# 보이는 이름과 캘린더 이름이 다르면 이름=캘린더 이름 (예: Family=가족). 이 줄을 지우면 아래 기본값 다섯 개를 씁니다.
# 비워 두면(CALENDAR_CATEGORIES=) 카테고리를 묻지 않고 예전처럼 "네"로 아래 CALENDAR_WRITE_TARGET(또는 기본 캘린더)에 넣습니다.
CALENDAR_CATEGORIES=Family,Teaching,Research,Event-Outside,Event-KHU
# (선택) 답할 때 쓸 한글 별칭 바꾸기: 카테고리=별칭|별칭, 쉼표로 구분. 적은 카테고리만 바뀝니다.
# 기본: Family=가족|집|개인, Teaching=강의|수업|티칭|교육, Research=연구, Event-Outside=외부|외부행사|학회, Event-KHU=경희|학교|교내|khu
CALENDAR_CATEGORY_ALIASES=
# (CALENDAR_CATEGORIES를 비웠을 때만) 일정을 추가할 캘린더 이름 (캘린더 앱 사이드바에 보이는 그대로, 대소문자 무시). 예: 연구
# 비우면 캘린더 앱의 기본 캘린더(캘린더 앱 설정 > 일반 > 기본 캘린더)에 넣습니다.
# 추가할 수 있는 캘린더, 카테고리와 지금 고른 캘린더는 python -m mungchi --calendar-setup 으로 확인하세요.
CALENDAR_WRITE_TARGET=
# 끝 시각이 없는 일정의 길이(분). 기본 60. 5~1440 사이의 정수가 아니면 60으로 봅니다.
DEFAULT_EVENT_MINUTES=60

# ── 음성으로 일정 등록 (Apple Silicon Mac에서만) ────────────────
# Slack에서 @일정·@고뭉치(·@업뎃)에게 보낸 음성 메시지를 이 Mac에서 글로 옮겨(mlx-whisper) 메모처럼 일정을 제안합니다.
# 음성은 Mac 밖으로 나가지 않고, Claude에는 받아쓴 글만 갑니다. README의 "음성으로 일정 등록" 참고.
# 처음 한 번: pip install -e . → python -m mungchi --voice-setup (모델 다운로드) → python -m mungchi service restart
# 음성 인식 모델 (Hugging Face 저장소 이름이나 모델 폴더). 기본 mlx-community/whisper-large-v3-turbo (약 1.6GB, 한국어에 좋음).
# 더 빠르고 작은 모델: mlx-community/whisper-small-mlx (약 0.5GB, 정확도는 조금 낮음). 바꾼 뒤에는 --voice-setup을 다시 실행하세요.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# 말하는 언어 (Whisper 언어 코드). 기본 ko. 비워 두면(WHISPER_LANGUAGE=) 언어를 스스로 알아냅니다.
WHISPER_LANGUAGE=ko
# 들을 수 있는 가장 긴 음성(초). 기본 300(5분). 1~3600 사이의 정수가 아니면 300으로 봅니다. 파일은 25MB까지입니다.
VOICE_MAX_SECONDS=300

# ── Slack (선택) ──────────────────────────────────────
# Slack을 쓰지 않으면 모두 비워 두세요. 설정 방법은 README의 "Slack에서 부르기" 참고.
# Slack 앱은 봇마다 하나씩, 모두 세 개입니다(slack_manifests/ 폴더의 매니페스트로 만듦).
# 봇은 각각 선택입니다. 토큰 두 개(xoxb-, xapp-)를 모두 넣은 봇만 python -m mungchi slack 한 번으로 함께 켜집니다.
# 토큰을 하나만 넣으면 봇이 시작하지 않고 빠진 변수 이름을 알려 줍니다.

# 고뭉치 봇 (@moongchi, 앱 이름 "비서실 고뭉치", slack_manifests/moongchi.yaml): 업뎃·일정에게 일을 맡겨 브리핑하는 비서실장.
# Bot User OAuth Token (xoxb-로 시작). 앱 설정 > OAuth & Permissions에서 복사. 아침 브리핑과 --brief --slack도 이 토큰을 씁니다.
SLACK_BOT_TOKEN=
# App-Level Token (xapp-로 시작, connections:write 권한). 앱 설정 > Basic Information > App-Level Tokens에서 생성.
# Socket Mode 봇(python -m mungchi slack)에만 필요합니다.
SLACK_APP_TOKEN=

# 업뎃 봇 (@update, 앱 이름 "업뎃", slack_manifests/update.yaml): 공저자가 Dropbox에서 바꾼 파일 목록을 바로 알려 줌. 선택.
# 업뎃 앱의 Bot User OAuth Token (xoxb-로 시작).
SLACK_UPDATE_BOT_TOKEN=
# 업뎃 앱의 App-Level Token (xapp-로 시작, connections:write 권한).
SLACK_UPDATE_APP_TOKEN=

# 일정 봇 (@schedule, 앱 이름 "일정", slack_manifests/schedule.yaml): 캘린더 일정을 바로 알려 줌. 선택.
# 일정 앱의 Bot User OAuth Token (xoxb-로 시작).
SLACK_SCHEDULE_BOT_TOKEN=
# 일정 앱의 App-Level Token (xapp-로 시작, connections:write 권한).
SLACK_SCHEDULE_APP_TOKEN=

# 봇이 답해 줄 사람의 Slack 멤버 ID (U로 시작, 쉼표로 구분). 세 봇이 함께 씁니다. 비어 있으면 봇이 시작하지 않습니다.
# 봇들은 개인 데이터를 읽으므로 보통 내 멤버 ID 하나만 넣습니다. (프로필 → ⋮ → 멤버 ID 복사)
SLACK_ALLOWED_USER_IDS=
# (선택) 아침 브리핑과 --brief --slack을 올릴 채널 ID (C로 시작). 내 멤버 ID(U로 시작)를 넣으면 고뭉치 봇과의 DM으로 받습니다.
# 비워 두면 SLACK_ALLOWED_USER_IDS의 사람마다 고뭉치 봇 DM으로 보냅니다.
SLACK_BRIEF_CHANNEL=
# 세 봇을 합쳐 동시에 처리할 최대 요청 수 (비용 상한). 기본 2.
SLACK_MAX_CONCURRENT=2
