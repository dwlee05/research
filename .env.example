# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않습니다. 토큰은 절대 커밋하지 마세요.
# 비워 둔 소스는 "설정 안 됨"으로 보고되고, 나머지 소스는 정상적으로 동작합니다.

# ── Claude ─────────────────────────────────────────────
# Claude API 키 (console.anthropic.com에서 발급). `claude` CLI로 로그인해 두었다면 비워도 됩니다.
ANTHROPIC_API_KEY=
# 고뭉치가 쓸 모델 (업뎃·일정은 같은 모델을 그대로 이어받습니다). 비워 두면 기본 모델(아래 값)을 씁니다.
MUNGCHI_MODEL=claude-opus-5-5

# ── 공통 ──────────────────────────────────────────────
# 일정·시각 표시에 쓸 시간대 (IANA 이름). 기본 Asia/Seoul.
TIMEZONE=Asia/Seoul
# 확인 기록이 없을 때 며칠 전부터 볼지. 기본 7.
LOOKBACK_DAYS=7
# 마지막 확인 시각을 저장할 파일 경로. 비우면 현재 폴더의 .mungchi_state.json.
MUNGCHI_STATE_FILE=
# 내 이름들 (쉼표로 구분, 대소문자 무시). Overleaf 커밋에서 내 작업을 빼는 데 씁니다.
MY_NAMES=홍길동,Gildong Hong
# 내 이메일들 (쉼표로 구분, 대소문자 무시). MY_NAMES와 MY_EMAILS 중 하나 이상은 꼭 채우세요.
MY_EMAILS=gildong@example.com

# ── Dropbox (업뎃) ────────────────────────────────────
# 방법 1: 액세스 토큰 하나 (앱 콘솔에서 생성. 몇 시간 뒤 만료되므로 테스트용).
DROPBOX_ACCESS_TOKEN=
# 방법 2 (권장): 만료되지 않는 리프레시 토큰 + 앱 키 + 앱 시크릿. README의 발급 방법 참고.
DROPBOX_REFRESH_TOKEN=
# Dropbox 앱 콘솔 Settings 탭의 App key.
DROPBOX_APP_KEY=
# Dropbox 앱 콘솔 Settings 탭의 App secret.
DROPBOX_APP_SECRET=
# 확인할 폴더. 기본값은 /20_연구-진행 (Dropbox 맨 위의 20_연구-진행 폴더)이라 비워 둬도 됩니다.
# 이 폴더가 다른 폴더 안에 있으면 전체 경로를 적으세요. 예: /Research/20_연구-진행
# 하위 폴더별로 공저자가 바꾼 파일 목록만 보고합니다(토큰 절약을 위해 파일 내용은 읽지 않음).
DROPBOX_ROOT_FOLDER=/20_연구-진행

# ── Overleaf (업뎃) ───────────────────────────────────
# Overleaf 계정 설정 > Git 연동에서 만든 Git 토큰 (Git 연동이 되는 유료 플랜 필요).
OVERLEAF_GIT_TOKEN=
# 확인할 프로젝트들. "이름=프로젝트ID"를 쉼표로 구분 (ID만 써도 됨). ID는 프로젝트 주소 끝부분.
OVERLEAF_PROJECTS=논문A=0123456789abcdef01234567,논문B=89abcdef0123456789abcdef
# 프로젝트를 git으로 받아 둘 캐시 폴더. 비우면 ~/.cache/mungchi/overleaf.
OVERLEAF_CACHE_DIR=

# ── 캘린더 ('일정' 에이전트) ─────────────────────────────────────
# ICS 주소들 (쉼표로 구분). Google 캘린더의 "비공개 주소(iCal 형식)", Outlook·iCloud ICS 주소 모두 가능.
# 이 주소는 비밀번호와 같습니다. 유출되면 캘린더 설정에서 재설정하세요.
CALENDAR_ICS_URLS=

# ── Slack (선택) ──────────────────────────────────────
# Slack을 쓰지 않으면 모두 비워 두세요. 설정 방법은 README의 "Slack에서 부르기" 참고.
# Slack 앱은 봇마다 하나씩, 모두 세 개입니다(slack_manifests/ 폴더의 매니페스트로 만듦).
# 봇은 각각 선택입니다. 토큰 두 개(xoxb-, xapp-)를 모두 넣은 봇만 python -m mungchi slack 한 번으로 함께 켜집니다.
# 토큰을 하나만 넣으면 봇이 시작하지 않고 빠진 변수 이름을 알려 줍니다.

# 고뭉치 봇 (@moongchi, 앱 이름 "비서실 고뭉치", slack_manifests/moongchi.yaml): 업뎃·일정에게 일을 맡겨 브리핑하는 비서실장.
# Bot User OAuth Token (xoxb-로 시작). 앱 설정 > OAuth & Permissions에서 복사. --brief --slack도 이 토큰을 씁니다.
SLACK_BOT_TOKEN=
# App-Level Token (xapp-로 시작, connections:write 권한). 앱 설정 > Basic Information > App-Level Tokens에서 생성.
# Socket Mode 봇(python -m mungchi slack)에만 필요합니다.
SLACK_APP_TOKEN=

# 업뎃 봇 (@update, 앱 이름 "업뎃", slack_manifests/update.yaml): 공저자가 Dropbox·Overleaf에서 바꾼 목록을 바로 알려 줌. 선택.
# 업뎃 앱의 Bot User OAuth Token (xoxb-로 시작).
SLACK_UPDATE_BOT_TOKEN=
# 업뎃 앱의 App-Level Token (xapp-로 시작, connections:write 권한).
SLACK_UPDATE_APP_TOKEN=

# 일정 봇 (@schedule, 앱 이름 "일정", slack_manifests/schedule.yaml): 캘린더 일정을 바로 알려 줌. 선택.
# 일정 앱의 Bot User OAuth Token (xoxb-로 시작).
SLACK_SCHEDULE_BOT_TOKEN=
# 일정 앱의 App-Level Token (xapp-로 시작, connections:write 권한).
SLACK_SCHEDULE_APP_TOKEN=

# 봇이 답해 줄 사람의 Slack 멤버 ID (U로 시작, 쉼표로 구분). 세 봇이 함께 씁니다. 비어 있으면 봇이 시작하지 않습니다.
# 봇들은 개인 데이터를 읽으므로 보통 내 멤버 ID 하나만 넣습니다. (프로필 → ⋮ → 멤버 ID 복사)
SLACK_ALLOWED_USER_IDS=
# --brief --slack이 고뭉치의 브리핑을 올릴 채널 ID (C로 시작). 내 멤버 ID를 넣으면 고뭉치 봇과의 DM으로 받습니다.
SLACK_BRIEF_CHANNEL=
# 세 봇을 합쳐 동시에 처리할 최대 요청 수 (비용 상한). 기본 2.
SLACK_MAX_CONCURRENT=2
